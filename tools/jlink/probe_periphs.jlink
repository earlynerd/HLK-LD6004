// Read-only peripheral enumeration: NVIC enables, SysTick, ARM CID/PID per 4K block,
// and the newly-found blocks. No halt, no writes.
exitonerror 0
connect
// NVIC ISER0-2 (enabled IRQs) + ICER mirror
mem32 0xE000E100 3
mem32 0xE000E180 3
// SysTick LOAD/VAL/CTRL
mem32 0xE000E014 3
// SCB AIRCR/SHCSR (reset-cause hints)
mem32 0xE000ED08 1
mem32 0xE000ED1C 1
// CID (0xFD8/FDC) + PID (0xFF8/FFC) of each 4K peripheral block
mem32 0x40000FD8 2
mem32 0x40000FF8 2
mem32 0x40001FD8 2
mem32 0x40001FF8 2
mem32 0x40002FD8 2
mem32 0x40002FF8 2
mem32 0x40003FD8 2
mem32 0x40003FF8 2
mem32 0x40004FD8 2
mem32 0x40004FF8 2
mem32 0x40005FD8 2
mem32 0x40005FF8 2
mem32 0x40006FD8 2
mem32 0x40006FF8 2
mem32 0x40007FD8 2
mem32 0x40007FF8 2
mem32 0x40008FD8 2
mem32 0x40008FF8 2
mem32 0x40009FD8 2
mem32 0x40009FF8 2
mem32 0x4000AFD8 2
mem32 0x4000AFF8 2
mem32 0x4000BFD8 2
mem32 0x4000BFF8 2
mem32 0x4000CFD8 2
mem32 0x4000CFF8 2
mem32 0x4000DFD8 2
mem32 0x4000DFF8 2
mem32 0x4000EFD8 2
mem32 0x4000EFF8 2
mem32 0x4000FFD8 2
mem32 0x4000FFF8 2
mem32 0x40010FD8 2
mem32 0x40010FF8 2
mem32 0x40011FD8 2
mem32 0x40011FF8 2
mem32 0x40012FD8 2
mem32 0x40012FF8 2
mem32 0x4001EFD8 2
mem32 0x4001EFF8 2
mem32 0x4001FFD8 2
mem32 0x4001FFF8 2
mem32 0x40020FD8 2
mem32 0x40020FF8 2
mem32 0x40021FD8 2
mem32 0x40021FF8 2
mem32 0x40022FD8 2
mem32 0x40022FF8 2
mem32 0x40023FD8 2
mem32 0x40023FF8 2
mem32 0x40024FD8 2
mem32 0x40024FF8 2
mem32 0x4002EFD8 2
mem32 0x4002EFF8 2
// newly-found blocks: live values
mem32 0x40007100 8
mem32 0x4001EA00 0x10
mem32 0x4001F000 0x10
mem32 0x4002EA00 0x10
q
