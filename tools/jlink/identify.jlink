// Read-only identification of the LD6004 radar SoC (ADT6101P) over SWD.
// No halt, reset, erase or write. Run with run_identify.ps1.
exitonerror 0
connect
// CPUID: core type and revision
mem32 0xE000ED00 1
// Debug/ROM table pointers and CoreSight component IDs
mem32 0xE00FF000 4
mem32 0xE00FFFD0 12
// Candidate code regions: boot area at 0, app vector table at 0x8000 (as in LD6002B)
mem32 0x00000000 8
mem32 0x00008000 8
// Common alternate code mappings (XIP flash windows)
mem32 0x08000000 4
mem32 0x10000000 4
mem32 0x18000000 4
mem32 0x60000000 4
// SRAM
mem32 0x20000000 4
q
